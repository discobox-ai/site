{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discobox-ai",
  "compatibility_date": "2026-09-01",
  // Serves the discobox install scripts; see the comment at its top. It runs
  // only for the paths run_worker_first names, so the rest of the site is
  // served straight from the assets, _redirects included.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/install.sh", "/install.ps1"]
  },
  // main deploys here. workers_dev is off so the only public URLs are the
  // custom domains -- no stray *.workers.dev copy of the site. edge.discobox.ai
  // serves the edge installer and, on any other path, this same site.
  "workers_dev": false,
  "routes": [
    { "pattern": "discobox.ai", "custom_domain": true },
    { "pattern": "edge.discobox.ai", "custom_domain": true }
  ],
  "env": {
    // the `preview` branch deploys here, as the discobox-ai-preview Worker.
    // Named environments inherit `main` but not `assets`, so it is repeated.
    "preview": {
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/", "/install.sh", "/install.ps1"]
      },
      "workers_dev": false,
      "routes": [{ "pattern": "preview.discobox.ai", "custom_domain": true }]
    }
  }
}
