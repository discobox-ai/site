{
  "name": "discobox-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:docs && astro build && node scripts/check-docs-build.mjs && node scripts/check-blog-build.mjs",
    "preview": "astro preview",
    "check": "pnpm run generate && oxlint --type-aware && oxfmt --check && tsc --noEmit && astro check",
    "sync:assets": "node scripts/sync-assets.mjs",
    "import:docs": "node scripts/import-docs.mjs",
    "check:docs": "node --test scripts/docs-check.test.mjs && node scripts/import-docs.mjs --check",
    "test:blog": "node --test scripts/blog-build.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "fmt": "oxfmt --write",
    "generate": "astro sync",
    "verify": "node scripts/verify.mjs",
    "ci": "pnpm run verify && pnpm run check && pnpm run test",
    "check:repo": "env GOTOOLCHAIN=auto GOPROXY=direct go run github.com/discobox-ai/repostd/cmd/repocheck@03b594feef8f250c4ba27a5457719067a3d336e8"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^26.4.0",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.128.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": "11.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
