---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

// This page is deliberately sober. The brand carries the concept on the index;
// here the technical register carries the proof. Everything on it is written
// from the implementation: the reference table at the end is the map back to
// it, and a claim that cannot be traced there does not belong here.
//
// Its argument, in order: the sandbox is one swappable layer (a provider);
// Discobox is everything around it; and the proxy Discobox deploys beside
// every pool's boxes is the one way out, which is where secrets and policy
// are enforced.

const repo = 'https://github.com/discobox-ai/discobox/blob/main';

// What Discobox manages, whatever the provider.
const managed = [
  {
    name: 'Harness',
    body: 'Which agent a box runs: Claude Code, Codex, OpenCode or any terminal agent in an image. Its settings and logins are saved once and every new box starts with them.',
  },
  {
    name: 'Source',
    body: 'A box is cut from a repository or a directory at a commit. Git reaches it through the control plane, and work leaves as commits pushed to a remote.',
  },
  {
    name: 'Secrets',
    body: 'Stored encrypted on the control plane. A box holds only sentinels, placeholders shaped like the real key, and the proxy swaps in the value on the way out.',
  },
  {
    name: 'Access control',
    body: 'A secret is bound to a box, a harness or a project with routes: methods, hosts and paths. Agents ask for more while they work, and a person, or a lead box with delegated rights, answers.',
  },
  {
    name: 'Network policy',
    body: 'Egress allow lists and deny-by-default, set on the project, the pool, the harness or one box, enforced at the proxy.',
  },
  {
    name: 'Audit',
    body: 'Every request a box makes is recorded against that box, and kept after the box is gone.',
  },
];

const swap = [
  {
    step: 'Detect',
    body: 'The proxy holds a per-box set of sentinel strings and matches them exactly. It never parses sentinel structure, which is what lets a sentinel mimic any provider key format byte for byte. Values are scanned as themselves and through any base64 token carrying them, so a credential riding in Authorization: Basic is not invisible.',
  },
  {
    step: 'Authorize',
    body: 'A sentinel carries no host. Each destination triggers a resolution the control plane answers per secret and host: a grant must be live, cover this box, and cover the host and route the proxy actually observed.',
  },
  {
    step: 'Substitute',
    body: 'The real value is written into the header or query parameter on the way out and redacted from the audit row. It is cached per box, sentinel and host, bounded by the grant expiry, and never persisted.',
  },
  {
    step: 'Fail',
    body: 'On denial, a pending approval or a resolver error, the sentinel is left in place and the upstream rejects it. Fail closed on the secret, fail open on the request: the caller gets a 401, never the credential.',
  },
];

// The ledger is grouped under section bands (the design language's grouping
// device) rather than coloured row by row: the standing is a heading the rows
// share, said in words.
const standings = [
  { tone: 'strong', name: 'Structural', means: 'Holds against an agent that lies' },
  { tone: 'partial', name: 'Guardrail', means: 'Holds against an agent that errs' },
  { tone: 'weak', name: 'Caveat', means: 'Where the guarantee is narrower' },
];

const ledger = [
  {
    claim: 'The credential is not in the box',
    tone: 'strong',
    body: 'Cleartext leaves the control plane through one call, made by the pool proxy for one sentinel and one destination. A fully compromised box holds no credential to take.',
  },
  {
    claim: 'There is no second way out',
    tone: 'strong',
    body: 'Boxes join their pool’s internal network and nothing else. That network has no route off the pool, so the proxy is the only route rather than the default one.',
  },
  {
    claim: 'A credential resolves for one destination',
    tone: 'strong',
    body: 'Exfiltrating a sentinel gains nothing: sent anywhere else it fails to resolve, and the request carries a placeholder.',
  },
  {
    claim: 'Every use has a verdict on record',
    tone: 'strong',
    body: 'The call that takes a value is the call that carries the verdict, and the control plane persists it before anything is minted.',
  },
  {
    claim: 'The judge is a guardrail, not a boundary',
    tone: 'partial',
    body: 'It runs inside the box, so an agent that does not want to be judged can call the protocol directly. It catches the honest failure: drift from the task, an over-broad command, a prompt injection. It does not catch an agent that means to deceive.',
  },
  {
    claim: 'A box is as isolated as its provider makes it',
    tone: 'weak',
    body: 'The proxy, the internal network and the secret swap hold on every provider. The wall between a box and the machine it runs on is the provider’s, so it is as strong as the sandbox the provider gives.',
  },
];

const references = [
  { what: 'Sandbox providers: the provider seam, drivers and pools', href: `${repo}/server/providers/DESIGN.md`, label: 'providers/DESIGN.md' },
  { what: 'A pool is its own runtime host', href: `${repo}/docs/adr/0006-pool-is-the-runtime-host.md`, label: 'ADR 0006' },
  { what: 'A remote pool reaches the control plane over a channel the server opens', href: `${repo}/docs/adr/26-10-30-875-a-remote-pool-reaches-its-control-plane-over-a-channel-the-server-opens.md`, label: 'ADR 26-10-30-875' },
  { what: 'The proxy: certificates, audit, cache, sentinel swapping', href: `${repo}/proxy/DESIGN.md`, label: 'proxy/DESIGN.md' },
  { what: 'Pool agent: proxy wiring, network topology, credential broker', href: `${repo}/pool-agent/DESIGN.md`, label: 'pool-agent/DESIGN.md' },
  { what: 'Secrets: grants, requests, hosts, sentinel shape', href: `${repo}/server/internal/resources/secrets/DESIGN.md`, label: 'secrets/DESIGN.md' },
  { what: 'The agent credentials protocol', href: `${repo}/docs/agent-credentials-protocol.md`, label: 'agent-credentials-protocol.md' },
  { what: 'No credential without a verdict on record', href: `${repo}/docs/adr/0091-a-credential-is-not-issued-without-a-verdict-on-record.md`, label: 'ADR 0091' },
];
---

<BaseLayout
  title="Architecture — Discobox"
  description="Discobox plugs into sandbox and infrastructure providers: built-in providers on your desktop, third-party integrations in the cloud. It manages everything around the sandbox, from harness and source to secrets and access control, and every box's traffic leaves through a proxy it deploys."
>
  <SiteHeader />

  <main class="page doc">
    <header class="doc__head">
      <p class="eyebrow">Architecture</p>
      <h1 class="doc__title">Bring any sandbox. Discobox runs everything around it.</h1>
      <p class="lede doc__lede">
        Every harness runs in its own sandbox, and Discobox plugs into sandbox and
        infrastructure providers to get one. On your desktop it uses its built-in
        providers. In the cloud it runs through integrations with third parties. That
        sandbox layer is one part, and it swaps. Discobox manages what surrounds it: the
        harness, the source, secrets, access control, and the proxy every box's traffic
        goes through.
      </p>
    </header>

    <section class="doc__section doc__section--wide">
      <h2>Overview</h2>
      <p>
        Three parts. The <strong>control plane</strong> runs on your machine or a server
        you run, and holds what is yours: secrets, grants, policy, harness settings and
        the routes to your source. A <strong>pool</strong> is a runtime host a provider
        brings up. Discobox deploys its <strong>pool agent and proxy</strong> into every
        pool, and the pool's sandboxes run beside them on a network whose only way out is
        that proxy.
      </p>

      <div class="arch" role="img"
        aria-label="The control plane holds secrets, grants, policy and harness settings, and opens a channel to each pool. A pool, brought up by any provider, holds one sandbox per harness. The sandboxes reach nothing but the pool agent and proxy, over an internal network. The proxy swaps secrets in per request and is the only route out to the internet.">
        <div class="frame frame--quiet arch__plane">
          <span class="frame__title">control plane</span>
          <p class="arch__where">your machine, or a server you run</p>
          <ul class="arch__chips">
            <li>secrets</li><li>grants</li><li>policy</li><li>harnesses</li><li>source</li><li>audit</li>
          </ul>
        </div>

        <div class="arch__wire" aria-hidden="true">
          <span class="arch__wire-label">channel to the pool · secrets resolved per request</span>
        </div>

        <div class="frame frame--quiet arch__pool">
          <span class="frame__title">pool · any provider</span>
          <p class="arch__where">built in on your desktop, or a third party in the cloud</p>

          <div class="arch__boxes">
            {
              [
                { harness: 'claude-code', source: 'acme/api' },
                { harness: 'codex', source: 'acme/web' },
                { harness: 'opencode', source: 'acme/docs' },
              ].map((box) => (
                <div class="frame frame--quiet arch__box">
                  <span class="frame__title">sandbox</span>
                  <dl class="arch__kv">
                    <dt>harness</dt><dd>{box.harness}</dd>
                    <dt>source</dt><dd>{box.source}</dd>
                    <dt>secrets</dt><dd>sentinels only</dd>
                  </dl>
                </div>
              ))
            }
          </div>

          <div class="arch__wire arch__wire--inner" aria-hidden="true">
            <span class="arch__wire-label">internal network · no other route</span>
          </div>

          <div class="frame arch__proxy">
            <span class="frame__title">pool agent + proxy</span>
            <ul class="arch__chips arch__chips--proxy">
              <li>mTLS per sandbox</li><li>TLS interception</li><li>policy</li><li>secret swap</li><li>audit</li>
            </ul>
          </div>
        </div>

        <div class="arch__wire" aria-hidden="true">
          <span class="arch__wire-label">the only route out</span>
        </div>

        <div class="frame frame--quiet arch__world">
          <span class="frame__title">the internet</span>
          <p class="arch__where">npm · github · your APIs · everything else</p>
        </div>
      </div>
    </section>

    <section class="doc__section">
      <h2>The sandbox is a provider</h2>
      <p>
        Discobox does not make you use its sandbox. It plugs into sandbox and
        infrastructure providers: a provider brings up the machine a pool runs on and
        gives Discobox a way to reach it, and everything above that is Discobox's and
        the same on every provider.
      </p>
      <p>
        <strong>On your desktop</strong>, Discobox has built-in providers, so a sandbox runs
        on your own machine with nothing else to set up. <strong>In the cloud</strong>,
        pools run through integrations with third parties: hosted sandbox platforms,
        cloud VMs, or servers you already run. Add one with{' '}
        <code>discobox admin provider create</code>, and choose where a box runs with{' '}
        <code>discobox run --pool</code>.
      </p>
      <p>
        A remote pool needs no address back to you. The server opens a channel to the
        pool, and the pool reaches the control plane through it, so a control plane on a
        laptop can run pools in the cloud.
      </p>
    </section>

    <section class="doc__section">
      <h2>What Discobox manages</h2>
      <p>
        The provider supplies the machine. Discobox supplies everything that makes it a
        place to run an agent safely, and none of it depends on which provider is
        underneath.
      </p>
      <dl class="managed">
        {
          managed.map((item) => (
            <div class="managed__item">
              <dt class="managed__name">{item.name}</dt>
              <dd class="managed__body">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="doc__section">
      <h2>The proxy</h2>
      <p>
        The proxy is the essential part. Discobox deploys it into every pool, beside the
        boxes, whatever the provider. Boxes join the pool's internal network and no
        other, and that network has no route off the pool. The proxy is therefore not a
        setting a box is asked to honour: unsetting <code>HTTP_PROXY</code> removes the
        route, not the restriction. Nested Docker and processes under sudo are wired to
        it too.
      </p>
      <p>
        Each box reaches the proxy over mTLS with a certificate issued when the box is
        created, and that certificate is its identity. Every policy decision, audit row
        and credential swap is attributed to one box. HTTPS is intercepted, so policy and
        the swap are evaluated against the request as it appears on the wire.
      </p>

      <h3 class="doc__sub">How a secret is used without entering the box</h3>
      <p>
        A box is given <strong>sentinels</strong>, not credentials. A sentinel is minted in
        the shape of the real provider key, <code>sk-ant-…</code> or <code>ghp_…</code>,
        and means nothing anywhere. The real value stays encrypted on the control plane
        and leaves it through one call, made by the pool proxy, for one sentinel and one
        destination.
      </p>

      <ol class="swap">
        {
          swap.map((entry) => (
            <li class="swap__item">
              <p class="swap__step">{entry.step}</p>
              <p class="swap__body">{entry.body}</p>
            </li>
          ))
        }
      </ol>

      <p>
        So prompt injection cannot steal a credential that is not there, and a leaked
        sentinel opens nothing. What an attacker inside the box can still do is{' '}
        <em>use</em>{' '}the credential within its grant: on its routes, until it expires.
      </p>
    </section>

    <section class="doc__section">
      <h2>Access on demand</h2>
      <p>
        An agent that needs access it was not given asks for it while it works. It names
        the credential, the exact routes it will send it on, and why. A person approves
        or denies it, or narrows it, and sets how long it lasts. A box that leads other
        boxes can be given a credential to delegate, and answers its workers' requests
        within those routes itself. An approved grant reaches the running agent's next
        command, with no restart.
      </p>
      <p>
        Before a wrapped command runs, a judge checks it against the use that was
        approved, and a credential is never issued without that verdict on record.{' '}
        <span class="tag tag--partial">Judging is in-box today</span>
      </p>
    </section>

    <section class="doc__section">
      <h2>What each control holds against</h2>
      <p>
        The controls above are not equally strong. The difference is whether they hold
        against an agent that errs or against one that lies.
      </p>

      <div class="ledger">
        {
          standings.map((standing) => {
            const rows = ledger.filter((row) => row.tone === standing.tone);
            return (
              <section class="ledger__group" aria-label={standing.name}>
                <div class="ledger__band">
                  <span class="ledger__standing">{standing.name}</span>
                  <span class="ledger__means">{standing.means}</span>
                  <span class="ledger__count">{rows.length}</span>
                </div>
                <ul class="ledger__rows">
                  {rows.map((row) => (
                    <li class="ledger__row">
                      <p class="ledger__claim">{row.claim}</p>
                      <p class="ledger__body">{row.body}</p>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>

      <p class="doc__aside">
        The controls that hold against a hostile agent are enforced outside the box, by
        the proxy and the control plane, and they are the same on every provider. The
        advisory ones sit on top of them.
      </p>
    </section>

    <section class="doc__section">
      <h2>What this does not defend against</h2>
      <ul class="limits">
        <li>
          <strong>A weak sandbox.</strong> A box is only as separated from the machine it
          runs on as its provider makes it. Choose the provider for the trust you need.
        </li>
        <li>
          <strong>Covert channels through allowed destinations.</strong> Data smuggled out
          in a commit message or an issue body, on a host you legitimately use. It is
          bounded, attributable and logged, not prevented.
        </li>
        <li>
          <strong>Payloads the proxy cannot read.</strong> An agent that encrypts before
          sending defeats content inspection.
        </li>
        <li>
          <strong>Anything downstream of an approved action.</strong> If you grant a
          credential that can delete production, the grant is the control. Scope its
          routes and expire it accordingly.
        </li>
        <li>
          <strong>What a compromised control plane holds.</strong> Cleartext secrets live
          there. It is the thing worth protecting once the boxes cannot be.
        </li>
      </ul>
    </section>

    <section class="doc__section">
      <h2>Read the source</h2>
      <p>
        Everything above is written from the implementation. These are the documents it
        came from, in the repository they live in.
      </p>
      <ul class="refs">
        {
          references.map((reference) => (
            <li class="ref">
              <span class="ref__what">{reference.what}</span>
              <a
                class="ref__link"
                href={reference.href}
                aria-label={`${reference.what} — ${reference.label}`}
              >
                {reference.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="doc__foot">
      Found something wrong here?{' '}
      <a href="https://github.com/discobox-ai/discobox/issues">Open an issue</a>.
    </p>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .doc {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3rem, 7vw, 5rem);
  }

  .doc__head {
    max-width: 62ch;
  }

  .doc__title {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .doc__lede {
    margin-top: 1.2rem;
    max-width: 62ch;
  }

  .doc__section {
    margin-top: clamp(2.75rem, 6vw, 4rem);
    max-width: 68ch;
  }

  /* The diagram wants the full measure; its prose still does not. */
  .doc__section--wide {
    max-width: none;
  }

  .doc__section--wide > h2,
  .doc__section--wide > p {
    max-width: 68ch;
  }

  .doc__section h2 {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .doc__section p {
    margin-top: 1rem;
    color: var(--text-muted);
  }

  .doc__section strong {
    color: var(--text);
    font-weight: 650;
  }

  .doc__section em {
    color: var(--text);
    font-style: normal;
  }

  .doc__section code {
    color: var(--text);
  }

  .doc__section .doc__aside {
    margin-top: 1.5rem;
    font-size: 0.93rem;
    color: var(--text-faint);
  }

  /* The architecture diagram ---------------------------------------------
     Built from the language's own devices: quiet frames with their titles on
     the border for each part, the one focused frame for the proxy, and grounds
     that step down as the parts nest (page, raised pool, sunken sandbox), so
     the nesting reads without squinting at hairlines. Connectors are drawn
     lines with an arrowhead, labelled with what crosses them. */

  .arch {
    margin-top: 2.25rem;
    display: grid;
  }

  .arch .frame--quiet {
    border-color: var(--line-bright);
  }

  .arch__plane,
  .arch__world {
    background: var(--ink-raised);
  }

  .arch__world {
    padding-block: 1.3rem 1rem;
  }

  .arch__pool {
    background: var(--ink-raised);
    padding: 1.6rem 1.3rem 1.3rem;
    display: grid;
    gap: 0;
  }

  .arch .arch__where {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .arch__chips {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .arch__chips li {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius-key);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
  }

  .arch__chips--proxy {
    margin-top: 0;
  }

  .arch__chips--proxy li {
    border-color: color-mix(in oklab, var(--magenta) 55%, var(--line-bright));
  }

  .arch__boxes {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.4rem 0.9rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 44rem) {
    .arch__boxes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* A sandbox sits on the sunken ground, one step below the pool; its title
     chip takes the same ground so it cuts the border cleanly. */
  .arch__box {
    background: var(--ink-sunken);
    padding: 1.3rem 1rem 0.9rem;
  }

  .arch__box .frame__title {
    background: var(--ink-sunken);
  }

  .arch__kv {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .arch__kv dt {
    color: var(--text-faint);
  }

  .arch__kv dd {
    margin: 0;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .arch__proxy {
    background: var(--ink-sunken);
    padding: 1.4rem 1.1rem 1rem;
  }

  .arch__proxy .frame__title {
    background: var(--ink-sunken);
  }

  /* A connector: a drawn line down the middle with an arrowhead at its foot,
     and what crosses it written beside the line. */
  .arch__wire {
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 1.1rem 1.3rem;
  }

  .arch__wire::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0.35rem;
    border-left: 1.5px solid var(--text-muted);
  }

  .arch__wire::after {
    content: '';
    position: absolute;
    left: calc(50% - 0.33rem);
    bottom: 0;
    border-left: 0.36rem solid transparent;
    border-right: 0.36rem solid transparent;
    border-top: 0.45rem solid var(--text-muted);
  }

  .arch__wire-label {
    position: relative;
    padding: 0.15rem 0.6rem;
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
  }

  .arch__wire--inner .arch__wire-label {
    background: var(--ink-raised);
  }

  /* Providers, and what is managed around them ----------------------------- */

  .managed {
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .managed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .managed__item {
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-bright);
  }

  .managed__name {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
  }

  .managed__body {
    margin: 0.35rem 0 0;
    font-size: 0.93rem;
    color: var(--text-muted);
  }

  .doc__sub {
    margin-top: 2rem;
    font-size: 1.1rem;
  }

  /* The swap --------------------------------------------------------------- */

  .swap {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    gap: 0;
  }

  .swap__item {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .swap__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .doc__section .swap__step {
    margin-top: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
  }

  .doc__section .swap__body {
    margin-top: 0;
    font-size: 0.93rem;
    color: var(--text-muted);
  }

  /* Ledger: rows grouped under section bands --------------------------- */

  .ledger {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.5rem;
  }

  .ledger__band {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-row);
    background: var(--line);
    font-family: var(--font-mono);
  }

  .ledger__standing {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text);
  }

  .ledger__means {
    flex: 1;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .ledger__count {
    font-size: var(--step--1);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .ledger__rows {
