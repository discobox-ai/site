---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InstallCommand from '../components/InstallCommand.astro';
import TerminalMark from '../components/TerminalMark.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import type { Line } from '../components/TerminalWindow.astro';

// The page a developer is sent to first: install, the tour, and three things
// to try that each show one reason to use discobox. It is the one page that
// keeps the disco: the mark dances here, and nowhere else on the site. Every
// command is the real CLI's (check them against --help as REVIEW.md says).
// In the prose under each terminal, `backticks` mark a command.

const tour: Line[] = [
  [
    { text: '$ ', tone: 'prompt' },
    { text: 'discobox run discobox-ai/tour', tone: 'command' },
  ],
];

const tries: { name: string; body: string; title: string; lines: Line[]; after: string }[] = [
  {
    name: 'Three agents, one repository',
    body: 'From any repository you have checked out, start three boxes with three prompts. Each gets its own clone, its own services and its own Docker, so none of them waits on another or on you.',
    title: '~/src/your-repo',
    lines: [
      [
        { text: '$ ', tone: 'prompt' },
        { text: "discobox run -d . 'fix the flakiest test'", tone: 'command' },
      ],
      [
        { text: '$ ', tone: 'prompt' },
        { text: "discobox run -d . 'add the feature at the top of the backlog'", tone: 'command' },
      ],
      [
        { text: '$ ', tone: 'prompt' },
        { text: "discobox run -d . 'try something you would never risk on main'", tone: 'command' },
      ],
      [
        { text: '$ ', tone: 'prompt' },
        { text: 'discobox ls', tone: 'command' },
      ],
    ],
    after: 'Attach to any of them with `discobox attach NAME` and leave with Ctrl-A d. Then run `git status` in your own checkout: nothing has changed there.',
  },
  {
    name: 'Watch the agent use a browser',
    body: 'Ask for something only a browser can answer. The agent opens Chromium on its own desktop, in its own box, with none of your tabs or logins in reach.',
    title: '~/src/your-repo',
    lines: [
      [
        { text: '$ ', tone: 'prompt' },
        { text: "discobox run . 'open the app in Chromium and screenshot it'", tone: 'command' },
      ],
      '',
      [{ text: '# in another terminal: forward its ports, then open localhost:6900', tone: 'dim' }],
      [
        { text: '$ ', tone: 'prompt' },
        { text: 'discobox proxy', tone: 'command' },
      ],
    ],
    after: 'Port 6900 is the box’s desktop, in a browser tab. Circle something on it and leave a note: the agent can read what you marked.',
  },
  {
    name: 'Give it a real key it never sees',
    body: 'Store a GitHub token once and bind it to a box. The agent gets a stand-in shaped like the token; the proxy swaps the real one in only on requests to the hosts you named.',
    title: '~/src/your-repo',
    lines: [
      [
        { text: '$ ', tone: 'prompt' },
        { text: 'discobox secret create --name github --token "$(gh auth token)" \\', tone: 'command' },
      ],
      [{ text: '    --route api.github.com', tone: 'command' }],
      [
        { text: '$ ', tone: 'prompt' },
        { text: 'discobox secret bind github BOX --as GH_TOKEN', tone: 'command' },
      ],
      '',
      [
        { text: '$ ', tone: 'prompt' },
        { text: "discobox exec BOX -- sh -c 'echo $GH_TOKEN'", tone: 'command' },
        { text: '   # a stand-in', tone: 'dim' },
      ],
      [
        { text: '$ ', tone: 'prompt' },
        { text: 'discobox exec BOX -- gh api user --jq .login', tone: 'command' },
        { text: ' # and yet: you', tone: 'dim' },
      ],
    ],
    after: 'BOX is any name `discobox ls` prints. Ask the agent to print the token, too; it can only print the stand-in.',
  },
];
---

<BaseLayout
  title="Try discobox"
  description="Install discobox, take the tour, then run three agents against one repository, watch one use its own browser, and give one a real GitHub token it never sees."
>
  <SiteHeader />
  <main>
    <section class="section try-hero">
      <div class="page try-hero__inner">
        <div class="try-hero__copy">
          <p class="eyebrow">Try it</p>
          <h1 class="try-hero__title">Let your agent dance.</h1>
          <p class="lede try-hero__lede">
            Ten minutes, your laptop, and a repository you already have. Install discobox,
            take the tour, then try the three things that make it click.
          </p>
        </div>

        <div class="dance" aria-hidden="true">
          <div class="dance__bot">
            <TerminalMark cell={10} class="dance__mark" />
          </div>
          <div class="dance__floor">
            {Array.from({ length: 12 }, (_, i) => <span class={`dance__tile dance__tile--${i % 4}`} />)}
          </div>
        </div>
      </div>
    </section>

    <section class="section try-steps">
      <div class="page">
        <ol class="steps">
          <li class="step">
            <p class="step__num">1</p>
            <div class="step__main">
              <h2 class="step__name">Install</h2>
              <p class="step__body">
                One line, for macOS, Linux or Windows. It installs the stable release, and
                boxes run on your own machine with nothing else to set up.
              </p>
              <InstallCommand class="step__install" />
            </div>
          </li>

          <li class="step">
            <p class="step__num">2</p>
            <div class="step__main">
              <h2 class="step__name">Take the tour</h2>
              <p class="step__body">
                A guided tour that runs full screen inside a box before your harness starts.
                No agent account is needed.{' '}
                <a href="https://github.com/discobox-ai/tour">Replay and cleanup instructions</a>.
              </p>
              <div class="step__demo">
                <TerminalWindow lines={tour} title="anywhere" />
              </div>
            </div>
          </li>
        </ol>

        <h2 class="couplet__hook try-three__title">Three things to try</h2>
        <ol class="tries">
          {
            tries.map((item) => (
              <li class="try">
                <div class="try__text">
                  <h3 class="try__name">{item.name}</h3>
                  <p class="try__body">{item.body}</p>
                </div>
                <div class="try__demo">
                  <TerminalWindow lines={item.lines} title={item.title} />
                  <p class="try__after">
                    {item.after.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="next">
          <p class="next__title">Then make it yours</p>
          <p class="next__body">
            The <a href="/docs/">manual</a> covers harnesses, sources and secrets. The{' '}
            <a href="/#personal-factory">personal factory</a> shows what a day with it looks
            like. Questions, or something broke: <a href="https://discord.gg/BSFr7Fa7f2">the Discord</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .try-hero {
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .try-hero__inner {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .try-hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .try-hero__title {
    font-size: clamp(2.4rem, 6vw, 3.9rem);
  }

  .try-hero__lede {
    margin-top: 1.25rem;
    font-size: clamp(1.06rem, 1.6vw, 1.18rem);
  }

  /* The playful part. The mark bobs to a beat over a floor of tiles lighting
     up in the brand's colours. The global reduced-motion rule stills both. */
  .dance {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    margin-inline: auto;
  }

  .dance__bot {
    animation: bob 0.94s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  .dance :global(.dance__mark) {
    display: block;
    width: clamp(9rem, 22vw, 14rem);
    height: auto;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    25% {
      transform: translateY(-0.5rem) rotate(0deg);
    }
    50% {
      transform: translateY(0) rotate(4deg);
    }
    75% {
      transform: translateY(-0.5rem) rotate(0deg);
    }
  }

  .dance__floor {
    display: grid;
    grid-template-columns: repeat(6, 1.6rem);
    gap: 0.25rem;
    transform: perspective(12rem) rotateX(55deg);
  }

  .dance__tile {
    height: 1rem;
    border-radius: 2px;
    opacity: 0.18;
    animation: light 1.88s steps(1, end) infinite;
  }

  .dance__tile--0 {
    background: var(--magenta);
  }

  .dance__tile--1 {
    background: var(--violet);
    animation-delay: -0.47s;
  }

  .dance__tile--2 {
    background: var(--gold);
    animation-delay: -0.94s;
  }

  .dance__tile--3 {
    background: var(--green);
    animation-delay: -1.41s;
  }

  @keyframes light {
    0% {
      opacity: 0.9;
    }
    25% {
      opacity: 0.18;
    }
  }

  .try-steps {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .steps,
  .tries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
  }

  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .step__num {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--magenta);
  }

  .step__num {
    width: 2.2rem;
    height: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-bright);
    border-radius: 50%;
  }

  .step__name {
    font-size: 1.3rem;
  }

  .step__body {
    margin-top: 0.5rem;
    max-width: 58ch;
    color: var(--text-muted);
  }

  .step :global(.step__install),
  .step__demo {
    margin-top: 1.1rem;
    max-width: 38rem;
  }

  .try-three__title {
    margin-top: clamp(3.5rem, 8vw, 5rem);
  }

  .tries {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .try {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    padding-top: clamp(1.75rem, 4vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 56rem) {
    .try {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .try__name {
    margin-top: 0.35rem;
    font-size: 1.2rem;
  }

  .try__body {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  .try__demo {
    min-width: 0;
  }

  .try__after {
    margin-top: 0.85rem;
    color: var(--text-faint);
    font-size: 0.9rem;
  }

  .next {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-bright);
    max-width: 62ch;
    display: grid;
    gap: 0.5rem;
  }

  .next__title {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .next__body {
    color: var(--text-muted);
  }
</style>
