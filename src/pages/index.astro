---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import HowRunsWork from '../components/HowRunsWork.astro';
import Factory from '../components/Factory.astro';
import PersistentAgents from '../components/PersistentAgents.astro';
import Safety from '../components/Safety.astro';
import CallToAction from '../components/CallToAction.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Discobox — the harness runtime"
  description="Discobox is a harness runtime. Give it a harness like Claude Code or Codex, a repository and a task, and it runs the harness in its own isolated sandbox, from a built-in provider or your own infrastructure, with full control inside and your secrets outside. Add your skills to build a software factory, or keep a named agent running for months."
>
  <SiteHeader />
  <main>
    <Hero />
    <HowRunsWork />
    <Factory />
    <PersistentAgents />
    <Safety />
    <CallToAction />
  </main>
  <SiteFooter />
</BaseLayout>
