---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ManyBoxes from '../components/ManyBoxes.astro';
import Desktop from '../components/Desktop.astro';
import HowRunsWork from '../components/HowRunsWork.astro';
import PersonalFactory from '../components/PersonalFactory.astro';
import Factory from '../components/Factory.astro';
import PersistentAgents from '../components/PersistentAgents.astro';
import Safety from '../components/Safety.astro';
import CallToAction from '../components/CallToAction.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Discobox — run five agents on your laptop at once"
  description="Run several coding agents on your laptop at once, each in a machine of its own with a clone of your repository, its own desktop and browser, and none of your keys, then merge only the work you like. Discobox is a harness runtime for Claude Code, Codex, OpenCode, GitHub Copilot, pi, omp or any terminal agent in an image, and it scales from your laptop to a team software factory."
>
  <SiteHeader />
  <main>
    <Hero />
    <ManyBoxes />
    <Desktop />
    <HowRunsWork />
    <PersonalFactory />
    <Factory />
    <PersistentAgents />
    <Safety />
    <CallToAction />
  </main>
  <SiteFooter />
</BaseLayout>
