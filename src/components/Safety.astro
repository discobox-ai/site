---
// Isolation in three lines and the picture that explains them. The judge,
// mTLS identities and hypervisor names are real, and are on /architecture;
// the homepage only has to make "isolated" believable.

const beats = [
  {
    name: 'Its own VM and container',
    body: 'Every run is a container inside a virtual machine, on Linux, macOS and Windows. Two layers between the harness and your computer.',
  },
  {
    name: 'Secrets stay outside',
    body: 'The box holds a placeholder, never the real credential. The proxy swaps the real value in only on requests to the host it belongs to.',
  },
  {
    name: 'One way out, logged',
    body: 'All traffic leaves through one proxy. Destinations are set by policy, and every request is logged against the run that made it.',
  },
];

// The controls behind the proxy, each shown as the command that sets it. All
// flags are real: admin project update --egress-*, secret bind --route/--for,
// discobox-access request (run by the agent inside the box) and secret
// request approve (see their --help).
const policies = [
  {
    name: 'Network access',
    body: 'Turn on deny-by-default and a run reaches only the destinations you allow: exact hosts, wildcards, IPs or CIDR ranges. Set it for the whole project, a harness, or a single run.',
    code: `$ discobox admin project update --egress-deny-by-default \\
    --egress-allow github.com,*.github.com,registry.npmjs.org`,
  },
  {
    name: 'Credential routes',
    body: 'Each credential is bound with routes: the methods, hosts and paths it may be sent to, down to GraphQL operations and MCP tools. Carve out exceptions, and set how long the binding lasts.',
    code: `$ discobox secret bind github bob --for 2w \\
    --route 'api.github.com/repos/acme/**' \\
    --route 'api.github.com/repos/*/*/pulls/*/merge=blocked'`,
  },
  {
    name: 'Permissions on demand',
    body: 'An agent starts with only what you gave it. When it needs more partway through a task, the agent files the request itself: which credential, the exact routes, and why. You approve or deny it, and a grant reaches the running agent’s next command with no restart.',
    // What the agent's own tool call looks like in its transcript, then the
    // person's answer from their terminal.
    agent: {
      tool: 'Bash',
      command: `discobox-access request --name github --env-var GH_TOKEN \\
  --route 'POST api.github.com/repos/acme/api/pulls' \\
  --justification "open the PR for the retry fix" --wait`,
      result: 'req_8fk2 sent · waiting for your answer…',
    },
    code: `$ discobox secret request approve req_8fk2 --for 2h`,
  },
];
---

<section class="section" id="safety">
  <div class="page">
    <p class="eyebrow">Isolation</p>
    <h2 class="couplet__hook">The harness gets the whole box. Your credentials never enter it.</h2>
    <p class="couplet__turn">
      A factory runs unattended and Bob holds credentials for months, so both need the
      same guarantee. Inside the box the agent is unrestricted. Anything that leaves it
      goes through one proxy, and that is where the controls are.
    </p>

    <div class="diagram" role="img"
      aria-label="A run's box on one side, the world on the other, and a single door between them holding your credentials.">
      <div class="zone zone--box">
        <p class="zone__label">the box</p>
        <p class="zone__lead">harness · sudo · docker · browser</p>
        <p class="zone__note">Unrestricted, by design</p>
      </div>

      <div class="door" aria-hidden="true">
        <div class="door__line"></div>
        <div class="door__badge frame">
          <span class="door__badge-title frame__title">the proxy</span>
          <span class="door__badge-sub">policy · audit log</span>
          <span class="door__keys">your credentials live here</span>
        </div>
        <div class="door__line"></div>
      </div>

      <div class="zone zone--world">
        <p class="zone__label">everything else</p>
        <p class="zone__lead">npm · github · your APIs · the internet</p>
        <p class="zone__note">Reached only through the proxy</p>
      </div>
    </div>

    <ul class="beats">
      {
        beats.map((beat) => (
          <li class="beat">
            <p class="beat__name">{beat.name}</p>
            <p class="beat__body">{beat.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="policy">
      <div class="policy__head">
        <h3 class="policy__title">Fine-grained policy</h3>
        <p class="policy__lede">
          You decide what each run can reach and what each credential can do, and
          every rule says exactly how far.
        </p>
      </div>

      <div class="policy__grid">
        {
          policies.map((policy) => (
            <div class="card policy__card">
              <div class="policy__text">
                <h4 class="policy__name">{policy.name}</h4>
                <p class="policy__body">{policy.body}</p>
              </div>
              <div class="policy__demo">
                {policy.agent && (
                  <div class="toolcall">
                    <p class="toolcall__who">the agent</p>
                    <div class="toolcall__call">
                      <span class="toolcall__dot" aria-hidden="true">●</span>
                      <span class="toolcall__tool">{policy.agent.tool}</span>
                      <pre class="toolcall__command">({policy.agent.command})</pre>
                    </div>
                    <p class="toolcall__result">
                      {policy.agent.result}
                    </p>
                  </div>
                )}
                {policy.agent && <p class="toolcall__who">you</p>}
                <pre class="policy__code">{policy.code}</pre>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <a class="button button--ghost safety__more" href="/architecture">How isolation works</a>
  </div>
</section>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.75rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  @media (min-width: 56rem) {
    .diagram {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 0;
    }
  }

  .zone {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1.4rem;
    background: linear-gradient(180deg, var(--ink-raised), color-mix(in oklab, var(--ink-raised) 55%, var(--ink)));
  }

  .zone--box {
    border-color: var(--line-bright);
  }

  .zone__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .zone--box .zone__label {
    color: var(--magenta);
  }

  .zone__lead {
    margin-top: 0.6rem;
    font-size: 1.02rem;
    color: var(--text);
  }

  .zone__note {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  /* The door is a full-height rule with the badge sitting in it, so the two
     sides read as separated by something rather than merely adjacent. */
  .door {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-block: 0.5rem;
  }

  @media (min-width: 56rem) {
    .door {
      padding-inline: 1.5rem;
    }
  }

  .door__line {
    flex: 1;
    width: 100%;
    min-height: 1.25rem;
    border-top: 1px dashed var(--line-bright);
  }

  @media (min-width: 56rem) {
    .door__line {
      width: 0;
      min-height: 0;
      border-top: 0;
      border-left: 1px dashed var(--line-bright);
    }
  }

  .door__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
    padding: 1.2rem 1.1rem 0.85rem;
    background: var(--ink-sunken);
  }

  /* The proxy is the section's one focused frame: its title rides the border. */
  .door__badge-title {
    background: var(--ink-sunken);
    white-space: nowrap;
  }

  .door__badge-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .door__keys {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--text);
    white-space: nowrap;
  }

  .beats {
    list-style: none;
    padding: 0;
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 56rem) {
    .beats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .beat {
    border-top: 1px solid var(--line-bright);
    padding-top: 0.85rem;
  }

  .beat__name {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .beat__body {
    margin-top: 0.45rem;
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .policy {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    display: grid;
    gap: 1.5rem;
  }

  .policy__head {
    display: grid;
    gap: 0.5rem;
  }

  .policy__title {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
  }

  .policy__lede {
    color: var(--text-muted);
    max-width: 58ch;
  }

  .policy__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  /* One rule per row, its explanation beside the command that sets it: the
     commands are too long to share a row three ways. */
  .policy__card {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .policy__card {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 2rem;
    }
  }

  .policy__text {
    display: grid;
    gap: 0.5rem;
  }

  .policy__name {
    margin: 0;
    font-size: 1.05rem;
  }

  .policy__body {
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .policy__demo {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  /* An agent's tool call as a harness draws it in its transcript: a bullet,
     the tool's name, its input in parentheses, and the result hanging off a
     corner below. Drawn on the ground, not in a terminal frame, because it is
     the agent's transcript and not a shell. */
  .toolcall {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
  }

  .toolcall__who {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .toolcall__call {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .toolcall__dot {
    color: var(--ok);
    margin-right: 0.6em;
  }

  .toolcall__tool {
    font-weight: 700;
    color: var(--text);
  }

  .toolcall__command {
    margin: 0;
    font: inherit;
    color: var(--text-muted);
    white-space: pre;
    overflow-x: auto;
  }

  /* The corner that hangs a result off its call, drawn rather than typed:
     the box-drawing glyph harnesses use is missing from many system monos. */
  .toolcall__result {
    position: relative;
    padding-left: 2.2em;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .toolcall__result::before {
    content: '';
    position: absolute;
    left: 0.9em;
    top: 0;
    width: 0.8em;
    height: 0.7em;
    border-left: 1px solid var(--text-faint);
    border-bottom: 1px solid var(--text-faint);
  }

  .toolcall + .toolcall__who {
    margin-top: 0.5rem;
  }

  .policy__code {
    margin: 0;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 4px);
    background: var(--ink-sunken);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--magenta);
    overflow-x: auto;
    white-space: pre;
  }

  .safety__more {
    margin-top: 2rem;
  }
</style>
