---
// The central diagram. Built from elements rather than an SVG so it reflows to
// a stacked column on narrow screens instead of shrinking its labels to
// nothing — and so the crossings stay readable text.

const crossings = [
  {
    name: 'Ingress',
    question: 'What is allowed in',
    body: 'Brokered, domain-bound credentials. Destination policy on every connection.',
  },
  {
    name: 'Egress',
    question: 'What is allowed out',
    body: 'One proxy, one mTLS identity per box, every request audited and attributable.',
  },
  {
    name: 'Effects',
    question: 'What is allowed to change',
    body: 'Anything privileged runs through a credential a human granted for that purpose.',
  },
];
---

<section class="section" id="boundary">
  <div class="page">
    <p class="eyebrow">The boundary</p>
    <p class="couplet__hook">Root on the floor. Keys at the door.</p>
    <p class="couplet__turn">
      Discobox watches three things and deliberately ignores everything else.
    </p>

    <div class="diagram" role="img"
      aria-label="A discobox on one side, the world on the other, and a single door between them holding your credentials.">
      <div class="zone zone--box">
        <p class="zone__label">the discobox</p>
        <p class="zone__lead">root · install anything · nested docker</p>
        <p class="zone__note">Unobserved, by design</p>
      </div>

      <div class="door" aria-hidden="true">
        <div class="door__line"></div>
        <div class="door__badge">
          <span class="door__badge-title">the door</span>
          <span class="door__badge-sub">MITM proxy · mTLS · audit</span>
          <span class="door__keys">your credentials live here</span>
        </div>
        <div class="door__line"></div>
      </div>

      <div class="zone zone--world">
        <p class="zone__label">everything else</p>
        <p class="zone__lead">npm · github · your APIs · the internet</p>
        <p class="zone__note">Reached only through the door</p>
      </div>
    </div>

    <ul class="crossings">
      {
        crossings.map((crossing) => (
          <li class="crossing">
            <p class="crossing__name">{crossing.name}</p>
            <p class="crossing__question">{crossing.question}</p>
            <p class="crossing__body">{crossing.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="closing">
      What the agent does <em>inside</em> is unobserved, and that is the design. In-box
      activity is inert: it only becomes risk when it leaves or when it causes an
      effect, and both are chokepoints. We do not police the thinking. We police the
      doors.
    </p>
  </div>
</section>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
    margin-top: 2.75rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  @media (min-width: 56rem) {
    .diagram {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 0;
    }
  }

  .zone {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem 1.4rem;
    background: linear-gradient(180deg, var(--ink-raised), color-mix(in oklab, var(--ink-raised) 55%, var(--ink)));
  }

  .zone--box {
    border-color: color-mix(in oklab, var(--magenta) 40%, var(--line));
    box-shadow: inset 0 0 60px -30px var(--glow);
  }

  .zone__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .zone--box .zone__label {
    color: var(--magenta);
  }

  .zone__lead {
    margin-top: 0.6rem;
    font-size: 1.02rem;
    color: var(--text);
  }

  .zone__note {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  /* The door is a full-height rule with the badge sitting in it, so the two
     sides read as separated by something rather than merely adjacent. */
  .door {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-block: 0.5rem;
  }

  @media (min-width: 56rem) {
    .door {
      padding-inline: 1.5rem;
    }
  }

  .door__line {
    flex: 1;
    width: 100%;
    min-height: 1.25rem;
    border-top: 1px dashed var(--line-bright);
  }

  @media (min-width: 56rem) {
    .door__line {
      width: 0;
      min-height: 0;
      border-top: 0;
      border-left: 1px dashed var(--line-bright);
    }
  }

  .door__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    text-align: center;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--gold);
    background: var(--ink-sunken);
    box-shadow: 0 0 40px -20px var(--gold);
  }

  .door__badge-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .door__badge-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .door__keys {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--gold);
    white-space: nowrap;
  }

  .crossings {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .crossings {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .crossing {
    border-top: 2px solid var(--magenta);
    padding-top: 0.9rem;
  }

  .crossing__name {
    font-weight: 650;
  }

  .crossing__question {
    font-size: 0.9rem;
    color: var(--text-faint);
  }

  .crossing__body {
    margin-top: 0.55rem;
    font-size: 0.94rem;
    color: var(--text-muted);
  }

  .closing {
    margin-top: 2.75rem;
    max-width: 62ch;
    font-size: 1.06rem;
    color: var(--text-muted);
  }

  .closing em {
    font-style: normal;
    color: var(--text);
  }
</style>
