---
// A terminal frame with its content as data rather than markup: a <pre> fed by
// a slot loses the line breaks the compiler collapses, and the lines are the
// one thing a terminal cannot be drawn without.

/** The roles the CLI's palette gives a color, not the colors themselves. */
export type Tone = 'prompt' | 'command' | 'ok' | 'warn' | 'dim' | 'cursor';

export interface Segment {
  text?: string;
  tone?: Tone;
}

/** A line is a run of colored segments, or plain text when it is all one. */
export type Line = Segment[] | string;

interface Props {
  title?: string;
  lines: Line[];
}

const { title = 'disco', lines } = Astro.props;

const segments = (line: Line): Segment[] => (typeof line === 'string' ? [{ text: line }] : line);
---

<div class="term">
  <div class="term__bar">
    <span class="term__dot term__dot--red" aria-hidden="true"></span>
    <span class="term__dot term__dot--gold" aria-hidden="true"></span>
    <span class="term__dot term__dot--green" aria-hidden="true"></span>
    <span class="term__title">{title}</span>
  </div>
  <div class="term__body">
    {
      lines.map((line) => (
        <div class="term__line">
          {segments(line).map((segment) => (
            <span
              class={segment.tone ? `tone tone--${segment.tone}` : undefined}
              aria-hidden={segment.tone === 'cursor'}
            >
              {segment.text}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .term {
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
    background: var(--ink-sunken);
    box-shadow:
      0 40px 80px -50px var(--glow),
      0 1px 0 0 color-mix(in oklab, var(--magenta) 12%, transparent) inset;
    overflow: hidden;
    /* Lines are `pre`, so without this the frame reports its widest line as a
       minimum and pushes the layout wider than the viewport. */
    min-width: 0;
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink-raised) 85%, transparent);
  }

  .term__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--line-bright);
  }

  .term__dot--red {
    background: color-mix(in oklab, var(--salmon) 80%, var(--magenta));
  }

  .term__dot--gold {
    background: var(--gold);
  }

  .term__dot--green {
    background: var(--green);
  }

  .term__title {
    margin-left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .term__body {
    padding: 1.1rem 1.2rem 1.3rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
    color: var(--text-muted);
    overflow-x: auto;
  }

  /* Each line keeps its own spacing so a blank one still takes a row, which is
     what a terminal does and what the padded columns above are aligned to. */
  .term__line {
    white-space: pre;
    min-height: 1.75em;
  }

  /* The roles the CLI already gives these colors: gold for attention, green
     for running, magenta for the mark and the prompt it draws. */
  .tone--prompt {
    color: var(--magenta);
  }

  .tone--command {
    color: var(--text);
  }

  .tone--ok {
    color: var(--green);
  }

  .tone--warn {
    color: var(--gold);
  }

  .tone--dim {
    color: var(--text-faint);
  }

  .tone--cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    translate: 0 0.18em;
    background: var(--magenta);
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
