---
import InstallCommand from './InstallCommand.astro';
import TerminalMark from './TerminalMark.astro';
import TerminalWindow from './TerminalWindow.astro';
import type { Line } from './TerminalWindow.astro';

// The claim, the picture of it, and the install. The claim is one developer's:
// several agents at once on your own machine, each in a box of its own, and
// you merge what you like. The picture is the three lines from the README's
// "Many sessions, many boxes", each printing the box it made. "The harness
// runtime" stays as the eyebrow for the reader who wants the category.
const runs = [
  { task: 'fix the flaky retry test', box: 'quiet-otter' },
  { task: 'add pagination to the users endpoint', box: 'amber-lynx' },
  { task: 'try replacing the ORM with sqlc', box: 'brave-heron' },
];

const session: Line[] = [
  ...runs.flatMap(({ task, box }): Line[] => [
    [
      { text: '$ ', tone: 'prompt' },
      { text: `discobox run -d . '${task}'`, tone: 'command' },
    ],
    [{ text: box, tone: 'ok' }],
  ]),
  '',
  [{ text: '# three agents, three boxes, one repository; your checkout is untouched', tone: 'dim' }],
];
---

<section class="hero">
  <div class="page hero__inner">
    <div class="hero__top">
      <div class="hero__lead">
        <p class="eyebrow">The harness runtime</p>

        <h1 class="hero__title">
          Run five agents on your laptop at once. <span class="hero__accent">Merge what you like.</span>
        </h1>

        <p class="lede hero__lede">
          Each agent gets a machine of its own: a clone of your repository, sudo, Docker, and
          its own desktop and browser. Start a fix, a feature and an experiment side by side,
          keep working in your own checkout, then review what comes back and merge only the
          work you want. Your checkout, your browser and your keys stay yours.
        </p>
      </div>

      <TerminalMark cell={14} class="hero__mark" label="The discobox mark" />
    </div>

    <div class="hero__runs">
      <TerminalWindow lines={session} title="~/src/api" />
    </div>

    <div class="hero__cta">
      <InstallCommand class="hero__install" />
      <p class="hero__tour">
        New here? Run <code>discobox run discobox-ai/tour</code>{' '}for a guided
        tour before your selected harness starts. No agent account is needed for
        the tour.{' '}
        <a href="https://github.com/discobox-ai/tour">Tour, replay and cleanup instructions</a>.
      </p>
    </div>

    <p class="hero__note">
      Claude Code, Codex, OpenCode, GitHub Copilot, pi and omp today, or any terminal
      agent in an image · Open
      source, in development
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 5.5rem) clamp(3rem, 7vw, 4.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* The copy, with the mark beside it on a wide screen. The mark is the one
     the CLI draws, so it stands for the product as a terminal shows it. */
  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .hero :global(.hero__mark) {
    display: none;
  }

  @media (min-width: 56rem) {
    .hero__top {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero :global(.hero__mark) {
      display: block;
      width: clamp(14rem, 26vw, 21rem);
      height: auto;
      margin-right: clamp(0rem, 3vw, 2.5rem);
    }
  }

  .hero__lead,
  .hero__note {
    max-width: 52ch;
  }

  .hero__tour {
    margin-top: 1rem;
    max-width: 48ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .hero__title {
    font-size: clamp(2.2rem, 5.4vw, 3.6rem);
    max-width: 18ch;
  }

  /* The wordmark's own run, magenta into gold, on the dark ground. On light
     ground gold is too faint for type, so it runs into violet instead. */
  .hero__accent {
    --accent-end: var(--gold);
    background: linear-gradient(100deg, var(--magenta), var(--accent-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .hero__accent {
      --accent-end: var(--violet);
    }
  }

  :global(:root[data-theme='light']) .hero__accent {
    --accent-end: var(--violet);
  }

  .hero__lede {
    margin-top: 1.5rem;
    font-size: clamp(1.06rem, 1.6vw, 1.18rem);
    max-width: 52ch;
  }

  .hero__runs {
    margin-top: clamp(2.25rem, 5vw, 3rem);
    max-width: 46rem;
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-faint);
  }
</style>
