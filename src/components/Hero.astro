---
import InstallCommand from './InstallCommand.astro';
import Screenshot from './Screenshot.astro';
import launcher from '../assets/screens/launcher.png';

// Copy on the left, the shot beside it. The column had seven blocks before —
// two buttons, two mono notes, and a GitHub link the header already carries —
// which left nothing dominant and no rhythm to the gaps. What is left is the
// claim, the one command, and the small print, at one spacing step.
---

<section class="hero">
  <div class="page hero__inner">
    <div class="hero__lead">
      <p class="eyebrow">Full autonomy for coding agents</p>

      <h1 class="hero__title">
        Give your agent its own <span class="hero__accent">disco</span>.
      </h1>

      <p class="lede hero__lede">
        A disposable machine your agent can do anything on: sudo, a desktop, a
        browser, nothing to approve. Your secrets never go inside it. And it stays one
        command away — ssh, your editor, VNC, commits back.
      </p>
    </div>

    <Screenshot
      class="hero__shot"
      src={launcher}
      alt="The Discobox launcher: three running discoboxes listed with their harness, branch and resource use, above the prompt a new one starts from."
      priority
      fade
      sizes="(min-width: 56rem) min(92vw, 118vh), calc(100vw - 2.5rem)"
    />

    <div class="hero__cta">
      <InstallCommand class="hero__install" />
    </div>

    <p class="hero__note">
      Claude Code and Codex today, or any terminal agent in an image · macOS, Linux,
      Windows · Open source, in development
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 5.5rem) clamp(3rem, 7vw, 4.5rem);
    /* The shot runs past the page's right edge; nothing may scroll sideways. */
    overflow-x: clip;
  }

  /* One column of copy. On a phone the shot sits in it, between the claim and
     the command; from 56rem it comes out of flow and stands beside the whole
     column. Out of flow rather than in a second grid track, because a tall
     item spanning the copy's rows pushes its excess height into the gaps
     between them — which is what made the spacing look arbitrary. */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* The prose measure, and it is used twice: the copy is capped at it, and the
     shot beside it starts one gap past whichever is wider, it or --pill.
     Written as a percentage as well as a ch so a cap and an offset resolve
     against the same containing block — they are not comparable otherwise, and
     on a wide-figured system font the copy would run under the opaque left of
     the capture. */
  .hero__inner {
    --copy: min(44ch, 46%);
    --copy-gap: 2.5rem;
    /* The width the install command stops fitting on one line at, which is
       InstallCommand.astro's container-query threshold restated: a container
       query cannot read a custom property, so the number lives there and this
       mirrors it. Both comments say so; change one and change the other.

       The pill's drawn width is its content, not this — they agree to within a
       pixel on the fonts to hand, and the slack in --copy-gap covers a font
       that draws the command wider than the threshold it stacks at. */
    --pill: 27rem;
  }

  .hero__lead,
  .hero__cta,
  .hero__note {
    max-width: 52ch;
  }

  .hero__title {
    font-size: clamp(2.4rem, 6vw, 3.9rem);
    max-width: 15ch;
  }

  .hero__accent {
    background: linear-gradient(100deg, var(--magenta), var(--gold));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lede {
    margin-top: 1.5rem;
    font-size: clamp(1.06rem, 1.6vw, 1.18rem);
    max-width: 50ch;
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-faint);
  }

  .hero :global(.hero__shot) {
    margin-top: clamp(2.5rem, 5vw, 3.25rem);
  }

  @media (min-width: 56rem) {
    .hero__inner {
      position: relative;
    }

    .hero__lead,
    .hero__note {
      max-width: var(--copy);
    }

    /* Not capped to the copy measure: that is for prose, and the install
       command is a control. Capping it made its container exactly as wide as
       the copy column, which is close enough to the width the command needs
       that the pill flipped to its stacked card somewhere in the middle of the
       laptop range — and always, on a system font with narrower figures. The
       block is full width and invisible; the pill inside it is what shows, at
       the left of the column, well clear of the shot. */
    .hero__cta {
      max-width: none;
    }

    /* Anchored just right of the copy and centred against it, running off the
       edge of the page. Its width is capped against the viewport height as
       well as its width, so the capture stays about as tall as the copy it
       stands beside on any shape of screen. */
    /* Past whichever of the two is wider: the prose measure, or the pill. The
       pill is the one that moves — it is rem and em throughout, so it grows
       with the visitor's default font size, while neither branch of --copy
       does (ch resolves against an absolute body size, and 46% is a share of
       the page). Bounding on the copy alone left the pill 2px clear at the
       browser default and inside the capture one step up the font-size menu. */
    .hero :global(.hero__shot) {
      position: absolute;
      top: 50%;
      left: calc(max(var(--copy), var(--pill)) + var(--copy-gap));
      translate: 0 -50%;
      width: min(92vw, 118vh);
      max-width: none;
      margin: 0;
      /* Where the mask has to be done by: the copy takes the left half, so a
         little over half the capture is what any screen actually shows. */
      --fade-start: 28%;
      --fade-end: 56%;
    }
  }
</style>
