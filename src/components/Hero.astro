---
import InstallCommand from './InstallCommand.astro';
import TerminalMark from './TerminalMark.astro';

// The claim, the command, and the install. The command is the picture: the
// whole product is one line with three arguments, and labelling each part
// under it says what discobox is faster than any screenshot can.

const parts = [
  { text: 'discobox run', tone: 'verb' },
  { text: '-H codex', label: 'harness' },
  { text: 'acme/api', label: 'source' },
  { text: '-p "fix the flaky retry test"', label: 'task' },
];
---

<section class="hero">
  <div class="page hero__inner">
    <div class="hero__top">
      <div class="hero__lead">
        <p class="eyebrow">The harness runtime</p>

        <h1 class="hero__title">
          Run any agent harness, <span class="hero__accent">isolated</span>.
        </h1>

        <p class="lede hero__lede">
          Discobox is a harness runtime. Give it a harness, a repository and a task, and it
          runs the harness in its own sandbox with its own copy of the code. The agent has
          full control inside the sandbox. Your secrets stay outside it. Add your team’s skills
          and it becomes a software factory.
        </p>
      </div>

      <TerminalMark cell={14} class="hero__mark" label="The discobox mark" />
    </div>

    <figure class="runline" aria-label='discobox run -H codex acme/api -p "fix the flaky retry test"'>
      <span class="runline__prompt" aria-hidden="true">$</span>
      {
        parts.map((part, index) => (
          <span class={`runline__part${part.label ? ' runline__part--arg' : ''}`} aria-hidden="true">
            <code class="runline__code">{part.text}{index < parts.length - 1 && <span class="runline__cont"> \</span>}</code>
            {part.label && <span class="runline__label">{part.label}</span>}
          </span>
        ))
      }
    </figure>

    <div class="hero__cta">
      <InstallCommand class="hero__install" />
      <p class="hero__tour">
        New here? Run <code>discobox run discobox-ai/tour</code>{' '}for a guided
        tour before your selected harness starts. No agent account is needed for
        the tour.{' '}
        <a href="https://github.com/discobox-ai/tour">Tour, replay and cleanup instructions</a>.
      </p>
    </div>

    <p class="hero__note">
      Claude Code, Codex, OpenCode, GitHub Copilot, pi and omp today, or any terminal
      agent in an image · Open
      source, in development
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 9vw, 5.5rem) clamp(3rem, 7vw, 4.5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* The copy, with the mark beside it on a wide screen. The mark is the one
     the CLI draws, so it stands for the product as a terminal shows it. */
  .hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2.5rem;
  }

  .hero :global(.hero__mark) {
    display: none;
  }

  @media (min-width: 56rem) {
    .hero__top {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero :global(.hero__mark) {
      display: block;
      width: clamp(14rem, 26vw, 21rem);
      height: auto;
      margin-right: clamp(0rem, 3vw, 2.5rem);
    }
  }

  .hero__lead,
  .hero__note {
    max-width: 52ch;
  }

  .hero__tour {
    margin-top: 1rem;
    max-width: 48ch;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .hero__title {
    font-size: clamp(2.4rem, 6vw, 3.9rem);
    max-width: 16ch;
  }

  /* The wordmark's own run, magenta into gold, on the dark ground. On light
     ground gold is too faint for type, so it runs into violet instead. */
  .hero__accent {
    --accent-end: var(--gold);
    background: linear-gradient(100deg, var(--magenta), var(--accent-end));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .hero__accent {
      --accent-end: var(--violet);
    }
  }

  :global(:root[data-theme='light']) .hero__accent {
    --accent-end: var(--violet);
  }

  .hero__lede {
    margin-top: 1.5rem;
    font-size: clamp(1.06rem, 1.6vw, 1.18rem);
    max-width: 52ch;
  }

  /* The command, drawn as a line of tokens with a bracket and a name under each
     argument. The tokens wrap as whole units, so on a phone the task drops to
     its own line with its label still under it. */
  .runline {
    margin: clamp(2.25rem, 5vw, 3rem) 0 0;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem) clamp(1rem, 2.5vw, 1.4rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    column-gap: 0.85em;
    row-gap: 0.9rem;
    border: 1px solid var(--line-bright);
    border-radius: var(--radius);
    background: var(--ink-sunken);
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 2.1vw, 1.35rem);
  }

  .runline__prompt {
    color: var(--text-faint);
    line-height: 1.5;
  }

  .runline__part {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
  }

  .runline__code {
    font-size: 1em;
    line-height: 1.5;
    white-space: pre;
    color: var(--text);
  }

  .runline__part--arg .runline__code {
    color: var(--magenta);
  }

  .runline__label {
    justify-self: stretch;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line-bright);
    font-size: 0.72rem;
    font-size: max(0.72rem, 0.5em);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* The continuation backslash only shows when the command is broken over
     lines, as a shell would need it. */
  .runline__cont {
    display: none;
    color: var(--text-faint);
  }

  /* On a phone the parts can't share a line, and wrapping them wherever they
     fall strands a label from its argument. So the command is written the way
     you would type it over several lines: one argument per line, continued
     with a backslash, each label beside its argument. */
  @media (max-width: 40rem) {
    .runline {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.6em;
      row-gap: 0.5rem;
      font-size: 0.95rem;
    }

    .runline__part {
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 1rem;
      row-gap: 0.1rem;
    }

    .runline__part--arg {
      padding-left: 1.2em;
    }

    .runline__cont {
      display: inline;
    }

    .runline__label {
      padding-top: 0;
      border-top: 0;
      font-size: 0.68rem;
    }
  }

  .hero__cta {
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--text-faint);
  }
</style>
