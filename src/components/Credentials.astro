---
import TerminalWindow from './TerminalWindow.astro';
import type { Line } from './TerminalWindow.astro';

const session: Line[] = [
  [{ text: '# the agent asks for a credential, and says what for', tone: 'dim' }],
  [
    { text: '$ ', tone: 'prompt' },
    { text: 'discobox secret request ls', tone: 'command' },
  ],
  [
    { text: 'req_8fk2  ', tone: 'warn' },
    { text: 'gh-token  api.github.com  pending', tone: 'dim' },
  ],
  [
    { text: '          "publish a release for this repo"' },
  ],
  '',
  [{ text: '# you decide', tone: 'dim' }],
  [
    { text: '$ ', tone: 'prompt' },
    { text: 'discobox secret approve req_8fk2 --secret-id gh-token', tone: 'command' },
  ],
  [
    { text: '✓', tone: 'ok' },
    { text: ' granted · host ' },
    { text: 'api.github.com', tone: 'warn' },
    { text: ' · expires ' },
    { text: '2h', tone: 'warn' },
  ],
  '',
  [{ text: '# the box only ever holds this', tone: 'dim' }],
  [
    { text: 'GITHUB_TOKEN=', tone: 'dim' },
    { text: 'dbx-sentinel-01J8F…', tone: 'warn' },
  ],
];---

<section class="section" id="credentials">
  <div class="page credentials">
    <div class="credentials__copy">
      <p class="eyebrow">Credentials</p>
      <p class="couplet__hook">Your agent gets a wristband, not your wallet.</p>
      <p class="couplet__turn">
        The agent can spend. It never holds the money. What sits in its environment
        is a sentinel — a placeholder that means nothing anywhere else. The real
        value is swapped in at the door, on the way out, and only against the domain
        you granted.
      </p>

      <ul class="beats">
        <li><strong>Nothing to exfiltrate.</strong> A fully compromised agent has no credential to steal.</li>
        <li><strong>Nothing to misdirect.</strong> A GitHub token is bound to GitHub. It resolves nowhere else.</li>
        <li><strong>Nothing unrecorded.</strong> Every injection is audited against the box that asked.</li>
      </ul>

      <a class="button button--ghost" href="/security#limitations">
        Where this is still a guardrail
      </a>
    </div>

    <div class="credentials__demo">
      <TerminalWindow lines={session} title="credential grant" />
    </div>
  </div>
</section>

<style>
  .credentials {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .credentials {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .beats {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 2rem;
    display: grid;
    gap: 0.7rem;
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .beats strong {
    color: var(--text);
    font-weight: 650;
  }

  .credentials__demo {
    min-width: 0;
  }
</style>
