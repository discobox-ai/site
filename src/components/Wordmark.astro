---
// The full lockup, inlined from the brand art.
//
// NOTE: the art in assets/brand currently reads "discobot" — it came over from
// that repository. Dropping corrected SVGs in at the same paths and re-running
// `go tool task site:logo` is the whole fix; nothing here needs to change.
//
// Loaded as an image rather than inlined: the art fills its type from an
// embedded `url(#linear-gradient)`, and that reference does not survive being
// parsed as HTML — the word comes out flat white. As an <img> the SVG is its
// own document and the gradient resolves.
//
// The variant is what the lockup is on a dark ground. On a light ground both
// give way to the black art: the gradient's gold end and the white letters do
// not read there. Which ground is showing is the page's theme (tokens.css).
//
// src/assets is generated by scripts/sync-assets.mjs from assets/brand.
import gradient from '../assets/wordmark-gradient.svg?url';
import white from '../assets/wordmark-white.svg?url';
import black from '../assets/wordmark-black.svg?url';

const VARIANTS = { gradient, white };

interface Props {
  variant?: keyof typeof VARIANTS;
  /** Height of the lockup; the art sets its own aspect. */
  size?: string;
  class?: string;
}

const { variant = 'gradient', size = '1.9rem', class: className } = Astro.props;
---

<span class:list={['wordmark', className]} style={`--wordmark-size:${size}`}>
  <img class="wordmark__dark" src={VARIANTS[variant]} alt="Discobox" decoding="async" />
  <img class="wordmark__light" src={black} alt="Discobox" decoding="async" />
</span>

<style>
  /* The art carries a viewBox and no width/height, so an <img> has no
     intrinsic size to derive a width from: it paints once and then collapses.
     The viewBox ratio is restated here so the box is deterministic — keep it
     in step with the art, or the wordmark renders stretched. */
  .wordmark {
    display: inline-flex;
    line-height: 0;
  }

  .wordmark img {
    display: block;
    height: var(--wordmark-size);
    width: auto;
    aspect-ratio: 993.18 / 178.1;
  }

  .wordmark__dark {
    filter: drop-shadow(0 0 14px color-mix(in oklab, var(--magenta) 28%, transparent));
  }

  .wordmark__light {
    display: none !important;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .wordmark__dark {
      display: none !important;
    }

    :global(:root:not([data-theme='dark'])) .wordmark__light {
      display: block !important;
    }
  }

  :global(:root[data-theme='light']) .wordmark__dark {
    display: none !important;
  }

  :global(:root[data-theme='light']) .wordmark__light {
    display: block !important;
  }
</style>
