---
// The mark, read from the brand originals at build time and inlined so it can
// be sized with the page rather than loaded as an image.
//
// assets/brand is the source art and carries the brand purple (#9e4aa7); it is
// used as-is rather than tinted to the site accent. Do not point this at the
// TUI capture: that is a rendering *of* this mark, not a source for it — see
// TerminalMark.astro.
// src/assets is generated by scripts/gen-logo.mjs from assets/brand.
import logo from '../assets/logo.svg?raw';

interface Props {
  size?: string;
  class?: string;
}

const { size = '2rem', class: className } = Astro.props;
---

<span class:list={['mark', className]} style={`--mark-size:${size}`} set:html={logo} />

<style>
  .mark {
    display: inline-flex;
    line-height: 0;
  }

  .mark :global(svg) {
    height: var(--mark-size);
    width: auto;
    filter: drop-shadow(0 0 14px color-mix(in oklab, var(--magenta) 40%, transparent));
  }
</style>
