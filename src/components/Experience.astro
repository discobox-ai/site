---
import Screenshot from './Screenshot.astro';
import openBox from '../assets/screens/claude-code.png';

// The third pillar. Autonomy and safety are what make a discobox possible; this
// is what makes it something you would actually use every day.

const buckets = [
  {
    name: 'ssh, or a shell in one keystroke',
    body:
      'Run discobox admin ssh-config --write once and ssh $DISCOBOX_ID works. discobox shell opens a shell in the box directly.',
    line: '$ ssh purple-mongoose',
  },
  {
    name: 'Your editor, attached',
    body:
      'The box is a normal ssh host, so VS Code, Cursor, JetBrains and any editor with a remote mode can open it. discobox tools vscode opens your editor at the project folder.',
    line: '$ discobox tools vscode',
  },
  {
    name: 'The desktop in your browser',
    body:
      'The box desktop and browser are served over VNC and noVNC. Forward the port to watch the agent, take over the mouse, or use the browser yourself.',
    line: '$ discobox proxy --port 6080',
  },
  {
    name: 'git in, commits out',
    body:
      'Your source is cloned into the box, and each box has its own git remote. discobox apply cherry-picks its commits onto your working tree, so you review real commits, not a raw diff.',
    line: '$ discobox apply purple-mongoose',
  },
  {
    name: 'Your toolchain comes along',
    body:
      'direnv runs on entry, so nix, mise or whatever your project declares sets up the toolchain. No Dockerfile to write. Boxes start in seconds.',
    line: 'direnv: loading .envrc · nix develop',
  },
  {
    name: 'Drive it or script it',
    body:
      'A TUI for interactive use, plus a scriptable CLI and a full OpenAPI API. Anything the TUI does can be scripted: create boxes, grant secrets, collect results.',
    line: '$ discobox ls --output json',
  },
];
---

<section class="section" id="experience">
  <div class="page">
    <p class="eyebrow">Experience</p>
    <h2 class="couplet__hook">The box is somewhere else. It should never feel like it.</h2>
    <p class="couplet__turn">
      The box is isolated from your machine, but you work with it as if it were
      local: ssh, a shell, your editor, the desktop over VNC and git, each one command
      away.
    </p>

    <Screenshot
      src={openBox}
      alt="One discobox open in the launcher: Claude Code working on the left, a shell on the right listing nested Docker containers, systemd services and listening sockets, with a forwarded port in the header."
      sizes="(min-width: 70.5rem) 68rem, calc(100vw - 2.5rem)"
      caption="One box, open: the agent on the left, a shell beside it, the services the repository declares as tabs, and a forwarded port in the header. Every key goes to the box."
    />

    <div class="buckets">
      {
        buckets.map((bucket) => (
          <div class="card bucket">
            <h3 class="bucket__name">{bucket.name}</h3>
            <p class="bucket__body">{bucket.body}</p>
            <p class="bucket__line">{bucket.line}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .buckets {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .buckets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .bucket {
    display: flex;
    flex-direction: column;
  }

  .bucket__name {
    font-size: 1.1rem;
  }

  .bucket__body {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.96rem;
    flex: 1;
  }

  .bucket__line {
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--magenta);
    overflow-x: auto;
    white-space: pre;
  }
</style>
