---
// The mark as a terminal draws it, from the same cell data the CLI renders.
//
// Drawn as rectangles rather than as text. Block-drawing characters are absent
// from most monospace fonts, so a browser substitutes them glyph by glyph from
// whatever font has them — and that font's advance width does not match the
// primary's, so the columns drift, and they drift asynchronously as fallback
// resolves, which is the shift you see on reload. Every block glyph covers a
// known fraction of its cell, so the cells are drawn as geometry instead and
// the mark stops depending on font metrics, hinting, or subpixel rounding.
//
// src/data/logo.json is generated by scripts/logo-cells.mjs from the TUI's
// capture and carries explicit colors: the page and the CLI paint the same
// mark, and neither interprets ANSI to do it.
import mark from '../data/logo.json';

interface Props {
  /** Rendered width of one cell; the mark scales with it. */
  cell?: number;
  label?: string;
  class?: string;
}

const {
  cell = 9,
  label = 'The discobox mark, as the CLI draws it',
  class: className,
} = Astro.props;

// A terminal cell is twice as tall as it is wide.
const CELL_W = 8;
const CELL_H = 16;

// Each block glyph as the fraction of its cell it covers: [x, y, w, h] in cell
// units. A space covers nothing, so a colored space paints only its background.
const GLYPHS: Record<string, [number, number, number, number] | null> = {
  ' ': null,
  '█': [0, 0, 1, 1],
  '▏': [0, 0, 1 / 8, 1],
  '▎': [0, 0, 1 / 4, 1],
  '▍': [0, 0, 3 / 8, 1],
  '▌': [0, 0, 1 / 2, 1],
  '▋': [0, 0, 5 / 8, 1],
  '▊': [0, 0, 3 / 4, 1],
  '▉': [0, 0, 7 / 8, 1],
  '▖': [0, 1 / 2, 1 / 2, 1 / 2],
  '▗': [1 / 2, 1 / 2, 1 / 2, 1 / 2],
  '▘': [0, 0, 1 / 2, 1 / 2],
  '▝': [1 / 2, 0, 1 / 2, 1 / 2],
  '▁': [0, 7 / 8, 1, 1 / 8],
  '▂': [0, 3 / 4, 1, 1 / 4],
  '▃': [0, 5 / 8, 1, 3 / 8],
  '▄': [0, 1 / 2, 1, 1 / 2],
  '▅': [0, 3 / 8, 1, 5 / 8],
  '▆': [0, 1 / 4, 1, 3 / 4],
  '▇': [0, 1 / 8, 1, 7 / 8],
};

interface Rect {
  x: number;
  y: number;
  w: number;
  h: number;
  fill: string;
}

// What the terminal's default background is, here: the page's own ground.
const GROUND = 'var(--ink)';

const rects: Rect[] = [];

mark.rows.forEach((row, line) => {
  let column = 0;
  for (const run of row as { t: string; f?: string; b?: string }[]) {
    for (const char of run.t) {
      const x = column * CELL_W;
      const y = line * CELL_H;
      column++;

      if (run.b) rects.push({ x, y, w: CELL_W, h: CELL_H, fill: run.b });

      const glyph = GLYPHS[char];
      if (glyph === undefined) throw new Error(`unmapped glyph ${JSON.stringify(char)}`);
      // A glyph with no foreground is drawn in the terminal's own ground, which
      // on this page is the page's. It carves a notch out of the cell behind
      // it, and those notches are the mark's shape — filling them in fattens
      // every block that has one.
      const fill = run.f ?? (run.b ? GROUND : null);
      if (glyph && fill) {
        const [gx, gy, gw, gh] = glyph;
        rects.push({
          x: x + gx * CELL_W,
          y: y + gy * CELL_H,
          w: gw * CELL_W,
          h: gh * CELL_H,
          fill,
        });
      }
    }
  }
});

const width = mark.width * CELL_W;
const height = mark.rows.length * CELL_H;
---

<svg
  class:list={['mark', className]}
  viewBox={`0 0 ${width} ${height}`}
  width={mark.width * cell}
  height={mark.rows.length * cell * 2}
  role="img"
  aria-label={label}
  shape-rendering="crispEdges"
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.fill} />)}
</svg>

<style>
  .mark {
    display: block;
    filter: drop-shadow(0 0 18px color-mix(in oklab, var(--magenta) 30%, transparent));
  }
</style>
