---
// Publishing this is the point. The project is in development, and the
// difference between what runs and what is designed is a claim about honesty
// that the rest of the page depends on.

interface Row {
  area: string;
  status: 'shipped' | 'partial' | 'designed';
  note?: string;
}

const rows: Row[] = [
  { area: 'Discoboxes, pools, harnesses', status: 'shipped' },
  { area: 'Claude Code and Codex harnesses', status: 'shipped', note: 'plus the built-in shell' },
  { area: 'Bring-your-own agent as a registered harness image', status: 'shipped', note: 'the contract is an OCI label; documentation pending' },
  { area: 'VM and container isolation', status: 'shipped', note: 'libkrun, Virtualization.framework, user namespaces' },
  { area: 'MITM proxy, per-box mTLS identity, destination policy, audit', status: 'shipped' },
  { area: 'Sentinel credential injection, domain binding, human approval', status: 'shipped' },
  { area: 'ssh / git / HTTP access, port forwarding, direnv, apply', status: 'shipped' },
  { area: 'Natural-language grants evaluated by a model', status: 'partial', note: 'a guardrail today, not yet a boundary' },
  { area: 'Trusted-side verification of credential use', status: 'designed', note: 'ADR 0031' },
  { area: 'Policy compiled from English to a deterministic engine', status: 'designed' },
  { area: 'Response-side inspection and data-flow policy', status: 'designed' },
];

const label = { shipped: 'Shipped', partial: 'Partial', designed: 'Designed' };
---

<section class="section" id="status">
  <div class="page">
    <p class="eyebrow">Where we are</p>
    <p class="couplet__hook">The hard part is done. The smart part is next.</p>
    <p class="couplet__turn">
      Discobox is pre-1.0 and under active development. The boundary, the identity on
      it, and the credential broker are running. The layer that reads what crosses and
      judges it is partly built. Nothing on this page is tagged as working unless it
      works.
    </p>

    <table class="status">
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">
                {row.area}
                {row.note && <span class="status__note">{row.note}</span>}
              </th>
              <td>
                <span class:list={['tag', `tag--${row.status}`]}>{label[row.status]}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="status__more">
      The full threat model, including what Discobox does <em>not</em> defend against,
      is on the <a href="/security">security page</a>.
    </p>
  </div>
</section>

<style>
  .status {
    width: 100%;
    margin-top: 2.25rem;
    border-collapse: collapse;
    text-align: left;
  }

  .status th {
    font-weight: 450;
    color: var(--text);
    padding: 0.95rem 1rem 0.95rem 0;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }

  .status tr:last-child th,
  .status tr:last-child td {
    border-bottom: 1px solid var(--line);
  }

  .status td {
    padding: 0.95rem 0;
    border-top: 1px solid var(--line);
    vertical-align: top;
    text-align: right;
    white-space: nowrap;
  }

  .status__note {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .status__more {
    margin-top: 1.75rem;
    color: var(--text-muted);
  }

  .status__more em {
    font-style: normal;
    color: var(--text);
  }
</style>
