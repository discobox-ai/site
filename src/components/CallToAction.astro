---
import InstallCommand from './InstallCommand.astro';
import TerminalMark from './TerminalMark.astro';

---

<section class="section cta" id="get-started">
  <div class="page cta__inner">
    <TerminalMark cell={9} class="cta__mark" />
    <p class="eyebrow">Get started</p>
    <h2 class="cta__title">Let your agent dance.</h2>
    <p class="lede cta__lede">
      One command builds a box from the current directory and starts your agent in it
      with no restrictions. Start as many as you have tasks, and apply each one's
      commits to your repo when it is done.
    </p>

    <InstallCommand class="cta__install" />

    <div class="cta__actions">
      <a class="button button--primary" href="https://github.com/discobox-ai/discobox">
        View on GitHub
      </a>
      <a class="button button--ghost" href="/architecture">Read the architecture</a>
    </div>
  </div>
</section>


<style>
  .cta {
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cta :global(.cta__mark) {
    margin-bottom: 1.75rem;
  }

  .cta__title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }

  .cta__lede {
    margin-top: 1rem;
    max-width: 48ch;
  }

  .cta :global(.cta__install) {
    margin-top: 2rem;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
